# .env 로 복사해서 실제 경로/값을 채운다:  cp .env.example .env

# 로그 경로 (없으면 각 파서의 기본 /var/log/... 경로 사용)
# --since-minutes 실행 시 같은 디렉터리의 로테이트 파일(.1, .N.gz)도 자동으로 읽는다.
# 서버 systemd 운영은 이 파일 대신 deploy/agentic-soc.env.example 을 쓴다.
APACHE_LOG_PATH=detection_pipeline/samples/sample_access.log        # 실 배포: /var/log/apache2/access.log
AUTH_LOG_PATH=detection_pipeline/samples/sample_auth.log            # 실 배포: /var/log/auth.log
SURICATA_LOG_PATH=detection_pipeline/samples/sample_eve.json        # 실 배포: /var/log/suricata/eve.json
AUDIT_LOG_PATH=detection_pipeline/samples/sample_audit.log          # 실 배포: /var/log/audit/audit.log

# auth: BSD syslog 헤더엔 연도가 없어 여기서 지정
AUTH_LOG_YEAR=2026

# web: 서버 자기 공인 IP (wp-cron 자기호출 제외, exclude_self 대상)
SERVER_PUBLIC_IP=54.180.11.0

# ── LLM 설정: 역할별 접두어 ─────────────────────────
# LLM을 쓰는 단계는 셋이고, 단계마다 접두어가 다르다. 한 단계의 모델을 바꿔도 다른 단계는 그대로다.
#   TRIAGE_         1차 탐지 트리아지 LLM 재검토 (llm/triage_review)  — 경량 모델
#   MAPPING_        ATT&CK 매핑 (llm/investigate/attack_mapping)    — 경량 모델 (트리아지와 같은 등급)
#   INVESTIGATION_  조사 에이전트 (llm/investigate)                 — 고성능 모델
# 접두어 없는 옛 이름(LLM_PROVIDER, CLAUDE_MODEL, CLAUDE_EFFORT, CLAUDE_REFUSAL_FALLBACK_MODEL, GEMINI_MODEL)은
# 어느 단계도 읽지 않는다(조사·매핑은 실행 시 이름만 안내). 자세한 설명: docs/LLM-역할별-설정-가이드.md

# 공용 키 — 역할 전용 키(<접두어>ANTHROPIC_API_KEY)가 비어 있으면 모든 단계가 이 키를 쓴다.
# 단계별 사용량을 콘솔에서 나눠 보고 싶으면 역할 전용 키를 따로 발급해 넣는다(쓴 변수 이름만 출력, 값은 출력 안 함).
ANTHROPIC_API_KEY=

# ── 1차 탐지 트리아지 (TRIAGE_) ─────────────────────
# Anthropic(Claude)만 지원. 모델을 비우면 claude-haiku-4-5
TRIAGE_CLAUDE_MODEL=claude-haiku-4-5
# TRIAGE_ANTHROPIC_API_KEY=

# ── ATT&CK 매핑 (MAPPING_) ──────────────────────────
# 비우면 anthropic. 모델을 비우면 claude-haiku-4-5 (조사 모델을 따라가지 않는다)
MAPPING_LLM_PROVIDER=anthropic
MAPPING_CLAUDE_MODEL=claude-haiku-4-5
# MAPPING_ANTHROPIC_API_KEY=
# 안전 필터 거절 시 재요청 모델(비우면 claude-sonnet-4-6, none이면 재요청 끔 — 경고 출력)
# MAPPING_CLAUDE_REFUSAL_FALLBACK_MODEL=
# (선택) MAPPING_LLM_PROVIDER=gemini일 때: MAPPING_GEMINI_API_KEY(비우면 GEMINI_API_KEY), MAPPING_GEMINI_MODEL

# ── 조사 에이전트 (INVESTIGATION_) ──────────────────
# 조사 에이전트·매핑은 이 루트 .env만 읽는다(llm/investigate/.env는 읽지 않음).
# 위 로그 경로를 상대경로로 두면 실행 폴더 기준이다 — 큐 폴러(run_investigation_queue.py)는 저장소 루트에서
# 실행하므로 그대로 맞고, llm/investigate/에서 main.py를 직접 돌릴 때는 절대경로를 쓴다.
INVESTIGATION_LLM_PROVIDER=anthropic
# 모델. 비우면 claude-sonnet-5(고성능). 비용을 아끼려면 haiku
INVESTIGATION_CLAUDE_MODEL=claude-haiku-4-5
# INVESTIGATION_ANTHROPIC_API_KEY=
# 안전 필터 거절(refusal) 시 같은 요청을 다시 보낼 다른 모델. 비우거나 줄이 없으면 claude-sonnet-4-6.
# none이면 재요청을 끈다(실험용, 경고 출력).
# INVESTIGATION_CLAUDE_REFUSAL_FALLBACK_MODEL=claude-sonnet-4-6
# (선택) 추론 강도 low|medium|high|xhigh|max. 비우면 보내지 않음(API 기본값)
# INVESTIGATION_CLAUDE_EFFORT=
# (선택) INVESTIGATION_LLM_PROVIDER=gemini일 때만: 조사 전용 키(비우면 GEMINI_API_KEY)와 모델(비우면 gemini-3.5-flash-lite)
# INVESTIGATION_GEMINI_API_KEY=
# INVESTIGATION_GEMINI_MODEL=

# ── GPT(OpenAI) — <역할>_LLM_PROVIDER=openai(또는 gpt)일 때만 ──
# ChatGPT 구독이 아니라 platform.openai.com의 API 키. 역할 전용 키(<역할>_OPENAI_API_KEY)가 비면 이 공용 키를 쓴다.
# OPENAI_API_KEY=
# 모델은 기본값이 없다 — 계정에서 쓸 수 있는 모델 이름을 지정한다(조사 INVESTIGATION_, 매핑 MAPPING_)
# INVESTIGATION_OPENAI_MODEL=
# MAPPING_OPENAI_MODEL=
# (선택) 추론 강도 none|low|medium|high|xhigh (이전 gpt-5는 minimal). 비우면 보내지 않음 — 모델 기본값이
# 모델마다 다르다(gpt-5.5 medium, gpt-5.4-mini none). 추론 토큰은 출력 요금으로 과금된다
# INVESTIGATION_OPENAI_REASONING_EFFORT=
# 조사 결과에 기록되는 수집 서버 이름(1차 탐지 사건에는 host가 없다). EC2에서는 `hostname` 결과. 비우면 web-01
HOST=
# (선택) 이 서버 이름과 다른 host로 조회하면 거부한다. 비워 두면 검사하지 않는다.
# LOG_LOCAL_HOST=
