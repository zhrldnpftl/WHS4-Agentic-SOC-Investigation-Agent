# 실제 키가 담긴 .env 파일은 절대 GitHub에 올리지 않는다.
# 이 파일을 복사해서 .env로 만들고 실제 발급받은 키를 채워 넣는다.
# cp .env.example .env

# ── LLM ─────────────────────────────────────────────
# anthropic(Claude, 기본) 또는 gemini
# 비워두면 기본값 anthropic으로 동작한다.
LLM_PROVIDER=anthropic

# Claude(Anthropic API) 키 — 기본 LLM
# INVESTIGATION_ANTHROPIC_API_KEY(조사 에이전트 전용)를 먼저 읽고, 비어 있으면 ANTHROPIC_API_KEY를 쓴다.
# 1차 탐지(llm/triage_review)도 ANTHROPIC_API_KEY를 쓰므로, 키를 나누려면 조사용 키를 아래 전용 이름에 넣는다.
# 어느 이름의 키를 썼는지는 실행 시 "[Claude] API 키: <이름> 사용"으로 표시된다(키 값은 출력하지 않음).
INVESTIGATION_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=
# (선택) Claude 모델. 비우면 claude-sonnet-5
# CLAUDE_MODEL=
# (선택) Claude 추론 강도 low|medium|high|xhigh|max. 비우면 API 기본값(high)
# CLAUDE_EFFORT=
# (선택) Claude가 안전 필터로 응답을 거절(refusal)했을 때 같은 요청을 다시 보낼 모델.
# 비우면 claude-sonnet-4-6, none 이면 다시 보내지 않음
# CLAUDE_REFUSAL_FALLBACK_MODEL=

# LLM_PROVIDER=gemini일 때만 필요 — Google AI Studio에서 발급한 Gemini API 키
GEMINI_API_KEY=
# (선택) Gemini 모델. 비우면 gemini-3.5-flash-lite. 특정 모델이 과부하(503)일 때 바꾼다
# GEMINI_MODEL=

# ── 수집 대상 ───────────────────────────────────────
# 조사 결과에 기록되는 수집 서버 이름(1차 탐지 사건에는 host가 없어 이 값으로 채운다). EC2에서는 `hostname` 결과. 비우면 web-01
HOST=

# ── 로그 경로 (EC2 서버의 실제 로그 파일을 직접 읽는다) ──
# 조사 도구가 원본 로그를 다시 읽을 때 쓴다(1차 탐지팀 공통 정규화 함수 사용, 웹은 Apache 형식).
# 변수 이름은 1차 탐지(run_pipeline.py)와 같다 — 한 서버에서 .env 하나로 함께 쓴다(예전 이름 *_LOG_LOCAL_PATH).
APACHE_LOG_PATH=/var/log/apache2/access.log
AUTH_LOG_PATH=/var/log/auth.log
AUDIT_LOG_PATH=/var/log/audit/audit.log
SURICATA_LOG_PATH=/var/log/suricata/eve.json

# 로컬 개발(내 PC)에서는 위 경로 대신 샘플 파일을 가리킨다.
# sample_logs/는 저장소에 없다(실제 트래픽 포함) — 팀원에게 받거나 scripts/fetch_sample_from_ec2.py로 받는다.
# APACHE_LOG_PATH=sample_logs/sample_apache_web.log
# AUTH_LOG_PATH=sample_logs/sample_auth.log
# AUDIT_LOG_PATH=sample_logs/sample_audit.log
# SURICATA_LOG_PATH=sample_logs/sample_network.log
# 연도 없는 syslog(auth) 샘플의 실제 연도. 비우면 조회 구간의 연도를 쓴다(EC2 실시간 로그는 비워 둔다).
# AUTH_LOG_YEAR=2026

# (선택) 이 서버 이름과 다른 host로 조회하면 거부한다. 비워 두면 검사하지 않는다.
# LOG_LOCAL_HOST=

# ── 오프라인 테스트/데모는 .env나 API 키 없이 실행한다 ──
# python -m pytest -q
# python -m scripts.demo_abcd
